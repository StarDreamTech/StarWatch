# 星哨 StarWatch 环境变量示例。复制为 .env 后按需修改，不要把真实密钥提交进仓库。

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=starwatch

# 调度器
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8080
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=1
SCHEDULER_BATCH_SIZE=20
SCHEDULER_MAX_CONCURRENCY=8
SCHEDULER_LOAD_CONCURRENCY=1
FETCHER_BASE_URL=http://localhost:8081
FETCHER_TIMEOUT_SECONDS=90
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 抓取器
FETCHER_HOST=0.0.0.0
FETCHER_PORT=8081

# 安全
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# 前端构建 / 本地开发（Vite 只会暴露 VITE_ 前缀）
VITE_API_BASE_URL=/api
STARWATCH_API_PROXY=http://127.0.0.1:8080
